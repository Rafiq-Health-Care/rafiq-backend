# Copy to `.env` and fill in secrets. Do not commit real keys.

POSTGRES_DB=rafiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST_PORT=5460

ADMINER_HOST_PORT=8888
MAILDEV_WEB_HOST_PORT=3080
MAILDEV_SMTP_HOST_PORT=1025
MAILDEV_WEB_PORT=3080
MAILDEV_SMTP_PORT=1025

DATASOURCE_URL=jdbc:postgresql://postgres:5432/rafiq
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=root
MAIL_HOST=mail-dev
MAIL_PORT=1025
MAIL_USERNAME=bialy
MAIL_PASSWORD=bialy
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=3000
MAIL_SMTP_WRITE_TIMEOUT=5000
MAIL_SMTP_TRUST=*
JWT_SECRET=
JWT_EXPIRATION=3600000
REFRESH_EXPIRATION=600000000
OTP_EXPIRATION=300000
ACCESS_TOKEN_EXPIRATION=360000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-pro
